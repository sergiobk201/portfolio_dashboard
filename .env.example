# Copy to .env at the repository root (git-ignored) and fill in the values.
# GitHub Actions uses repository secrets instead of this file.

# ── Supabase Postgres ──────────────────────────────────────────────
# db.<project-ref>.supabase.co is IPv6-only. On an IPv4-only network use the
# Session pooler from Project → Connect: host <...>.pooler.supabase.com,
# port 5432, user postgres.<project-ref>.
host=
port=5432
dbname=postgres
user=
password=
# Supabase requires SSL; only a local test database needs "disable".
DB_SSLMODE=require

# ── Ledger ingestion (pipelines/gmail_automation.py) ───────────────
# Password that opens the broker's nota de corretagem PDFs.
PASSWORD_PDF=

# ── Market data fallbacks ──────────────────────────────────────────
BRAPI_KEY=
FMP_API_KEY=

# ── Telegram alerts (private channel; leave empty to print alerts only)
PORT_BOT_TOKEN=
PORT_BOT_CHAT=
